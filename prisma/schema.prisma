// Maw3ed data model. See docs/DATA_MODEL.md.
// Rules: every tenant table has businessId and businessId-first indexes; times are UTC Timestamptz(3);
// money is Decimal(10,2); NO free-text notes columns (NFR-04).
// The appointment_no_overlap exclusion constraint, CHECKs and the ReminderJob partial index live in a
// hand-written migration (Prisma cannot express them). Never use `prisma db push`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum Role {
  OWNER
  STAFF
  /// A barber/practitioner with a phone login who sees only their own appointments (scoped routes arrive in PR-5).
  PRACTITIONER
}

enum TimeOffReason {
  VACATION
  SICK
  OTHER
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  PENDING_PAYMENT
  ATTENDED
  NO_SHOW
  CANCELLED
  LATE_CANCEL
}

enum AppointmentSource {
  PUBLIC
  FRONT_DESK
  WAITLIST
}

enum CancelledVia {
  LINK
  STAFF
  SYSTEM
}

enum ReminderKind {
  BOOKING
  H24
  H2
  /// F68: WhatsApp-only item for a PUBLIC booking made under 2 h before the slot (no H24/H2 can exist).
  LATE
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

enum WaitlistStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum OfferStatus {
  OPEN
  CLAIMED
  EXPIRED
  SUPERSEDED
}

enum PaymentPurpose {
  DEPOSIT
  PLAN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model Business {
  id                String   @id @default(cuid(2))
  slug              String   @unique
  name              String
  /// A key of src/lib/business/profile.ts CATEGORY_KEYS; legacy rows hold the free text typed before keys existed.
  category          String?
  /// A key of AREA_KEYS. NULL = not set (every row before PR-1).
  area              String?
  address           String?
  timezone          String   @default("Asia/Beirut")
  locale            String   @default("en")
  currency          String   @default("USD")
  slotStepMin       Int      @default(15)
  bookingWindowDays Int      @default(30)
  minNoticeMin      Int      @default(60)
  cancelCutoffMin   Int      @default(1440)
  plan              Plan     @default(FREE)
  depositEnabled    Boolean  @default(false)
  depositThreshold  Int      @default(1)
  depositAmount     Decimal  @default(5.00) @db.Decimal(10, 2)
  listed            Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  memberships   Membership[]
  sessions      Session[]
  invites       Invite[]
  activations   ActivationToken[]
  staff         StaffMember[]
  services      Service[]
  staffServices StaffService[]
  workingHours  WorkingHours[]
  timeOff       TimeOff[]
  clients       Client[]
  appointments  Appointment[]
  reminderJobs  ReminderJob[]
  waitlist      WaitlistEntry[]
  offers        WaitlistOffer[]
  baseline      PilotBaseline?
  payments      Payment[]
  oauthCodes    OAuthAuthorizationCode[]
  oauthGrants   OAuthGrant[]
  mcpPlans      McpPlan[]
  mcpAudit      McpAuditLog[]
  logo          BusinessLogo?

  /// Public directory filters (listed first: only opted-in businesses are read).
  @@index([listed, area, category])
}

/// The public logo of a business: one processed 256x256 WebP (no EXIF, no personal data). Kept out of Business so
/// Business queries never load image bytes. `hash` (sha256 of `bytes`) is the public version and the ETag.
model BusinessLogo {
  businessId String   @id
  mime       String
  bytes      Bytes
  width      Int
  height     Int
  hash       String
  updatedAt  DateTime @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model User {
  id              String    @id @default(cuid(2))
  /// Stored lowercased. NULL for phone-only accounts (CHECK: email or phone is set).
  email           String?   @unique
  /// E.164. NULL for e-mail-only accounts. Set when a staff activation link is used.
  phone           String?   @unique
  passwordHash    String?
  name            String
  /// When the address was proven (verify link, password reset, or accepted staff invite). NULL = unverified.
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  staff       StaffMember[]
  outcomes    Appointment[] @relation("OutcomeMarkedBy")
  sentJobs    ReminderJob[] @relation("ReminderSentBy")
  emailTokens EmailToken[]
  activations ActivationToken[]
  oauthCodes  OAuthAuthorizationCode[]
  oauthGrants OAuthGrant[]
}

enum EmailTokenKind {
  VERIFY
  RESET
}

/// Single-use e-mailed token (verify address / reset password). Only sha256(token) is stored.
model EmailToken {
  id        String         @id @default(cuid(2))
  userId    String
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime       @db.Timestamptz(3)
  usedAt    DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid(2))
  businessId String
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId])
  @@index([expiresAt])
}

model Membership {
  id         String   @id @default(cuid(2))
  businessId String
  userId     String
  role       Role
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId, role])
}

model Invite {
  id         String    @id @default(cuid(2))
  businessId String
  email      String
  role       Role      @default(STAFF)
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, email])
}

model StaffMember {
  id          String   @id @default(cuid(2))
  businessId  String
  userId      String?
  displayName String
  bookable    Boolean  @default(true)
  active      Boolean  @default(true)
  colour      String   @default("#0E7C66")
  /// Set when the owner turns the staff login off (userId is cleared); cleared again by a new activation link.
  loginOffAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  business     Business        @relation(fields: [businessId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])
  activations  ActivationToken[]
  services     StaffService[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]
  offers       WaitlistOffer[]
  waitlist     WaitlistEntry[]

  @@index([businessId, active, bookable])
  @@index([businessId, userId])
}

/// One-time staff activation link (hash only). One OPEN token per staff member (partial unique index in the migration).
model ActivationToken {
  id            String    @id @default(cuid(2))
  businessId    String
  staffMemberId String
  /// Set once used: the User who activated.
  userId        String?
  /// E.164 the owner entered; becomes User.phone on activation.
  phone         String
  tokenHash     String    @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id])
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])

  @@index([businessId, staffMemberId])
}

model Service {
  id          String   @id @default(cuid(2))
  businessId  String
  name        String
  durationMin Int
  bufferMin   Int      @default(0)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  business     Business        @relation(fields: [businessId], references: [id])
  staff        StaffService[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]

  @@index([businessId, active, sortOrder])
}

model StaffService {
  staffId    String
  serviceId  String
  businessId String // denormalised for scoping

  business Business    @relation(fields: [businessId], references: [id])
  staff    StaffMember @relation(fields: [staffId], references: [id])
  service  Service     @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
  @@index([businessId, serviceId])
}

model WorkingHours {
  id         String @id @default(cuid(2))
  businessId String
  staffId    String
  weekday    Int // 0 (Sunday) to 6 (Saturday); CHECK in migration
  startLocal String // HH:mm in Business.timezone
  endLocal   String // HH:mm, CHECK end > start in migration

  business Business    @relation(fields: [businessId], references: [id])
  staff    StaffMember @relation(fields: [staffId], references: [id])

  @@index([businessId, staffId, weekday])
}

model TimeOff {
  id         String        @id @default(cuid(2))
  businessId String
  staffId    String
  startAt    DateTime      @db.Timestamptz(3)
  endAt      DateTime      @db.Timestamptz(3)
  reason     TimeOffReason @default(OTHER)

  business Business    @relation(fields: [businessId], references: [id])
  staff    StaffMember @relation(fields: [staffId], references: [id])

  @@index([businessId, staffId, startAt])
}

model Client {
  id          String   @id @default(cuid(2))
  businessId  String
  name        String
  phone       String // E.164
  email       String?
  attended    Int      @default(0)
  noShows     Int      @default(0)
  lateCancels Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  business     Business        @relation(fields: [businessId], references: [id])
  appointments Appointment[]
  waitlist     WaitlistEntry[]

  @@unique([businessId, phone])
  @@index([businessId, name])
}

model Appointment {
  id                String            @id @default(cuid(2))
  businessId        String
  clientId          String
  staffId           String
  serviceId         String
  startAt           DateTime          @db.Timestamptz(3)
  endAt             DateTime          @db.Timestamptz(3)
  blockedUntil      DateTime          @db.Timestamptz(3) // endAt + service buffer
  status            AppointmentStatus @default(BOOKED)
  source            AppointmentSource @default(PUBLIC)
  idempotencyKey    String?
  // Short code shown to the client (6 characters, unambiguous alphabet). NOT a secret, NOT an auth token.
  // NULL on rows created before PR-6 (never backfilled).
  reference         String?           @unique
  // F16: where THIS booking's emails go. NULL = fall back to Client.email. Nulled when the client is anonymised.
  contactEmail      String?
  // F16 review: the name typed for THIS booking; the only name an email to a non-record address may use.
  contactName       String?
  confirmedAt       DateTime?         @db.Timestamptz(3)
  // PENDING_PAYMENT only: when the deposit hold lapses (15 min). The partial index lives in a migration.
  holdExpiresAt     DateTime?         @db.Timestamptz(3)
  cancelledAt       DateTime?         @db.Timestamptz(3)
  cancelledVia      CancelledVia?
  outcomeMarkedById String?
  outcomeMarkedAt   DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  business        Business        @relation(fields: [businessId], references: [id])
  client          Client          @relation(fields: [clientId], references: [id])
  staff           StaffMember     @relation(fields: [staffId], references: [id])
  service         Service         @relation(fields: [serviceId], references: [id])
  outcomeMarkedBy User?           @relation("OutcomeMarkedBy", fields: [outcomeMarkedById], references: [id])
  reminderJobs    ReminderJob[]
  claimedOffers   WaitlistOffer[] @relation("ClaimedAppointment")
  freedOffers     WaitlistOffer[] @relation("FreedFromAppointment")
  payments        Payment[]

  // appointment_no_overlap (EXCLUDE USING gist) is added by hand in the appointment_no_overlap migration.
  @@unique([businessId, idempotencyKey])
  @@index([businessId, staffId, startAt])
  @@index([businessId, startAt])
  @@index([businessId, clientId, startAt])
  @@index([businessId, status, startAt])
  /// PR-10: popular-service demand counts appointments created in a window.
  @@index([businessId, createdAt])
}

model ReminderJob {
  id                String          @id @default(cuid(2))
  businessId        String
  appointmentId     String
  kind              ReminderKind
  channel           ReminderChannel
  dueAt             DateTime        @db.Timestamptz(3)
  status            ReminderStatus  @default(PENDING)
  attempts          Int             @default(0)
  nextAttemptAt     DateTime?       @db.Timestamptz(3)
  lockedAt          DateTime?       @db.Timestamptz(3)
  sentAt            DateTime?       @db.Timestamptz(3)
  sentById          String?
  providerMessageId String?
  lastError         String? // short machine/provider error, not user-entered text
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sentBy      User?       @relation("ReminderSentBy", fields: [sentById], references: [id])
  // The partial index (status, dueAt) WHERE status = 'PENDING' is added in the hand-written migration.

  // Guarantee 2: no duplicate reminder. NEVER remove or narrow.
  @@unique([appointmentId, kind, channel])
  @@index([businessId, status, dueAt])
}

model WaitlistEntry {
  id              String         @id @default(cuid(2))
  businessId      String
  clientId        String
  serviceId       String
  staffId         String?
  fromDate        DateTime       @db.Timestamptz(3)
  toDate          DateTime       @db.Timestamptz(3)
  status          WaitlistStatus @default(OPEN)
  // Where offers go. Supplied at join and never copied onto the Client: an unauthenticated caller must
  // not be able to redirect an existing client's mail.
  contactEmail    String?
  // Atomic reservation held while one offer of this entry is being booked (F21). Released on failure,
  // ignored once older than the claim lease.
  claimingOfferId String?
  claimingAt      DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  business Business        @relation(fields: [businessId], references: [id])
  client   Client          @relation(fields: [clientId], references: [id])
  service  Service         @relation(fields: [serviceId], references: [id])
  staff    StaffMember?    @relation(fields: [staffId], references: [id])
  offers   WaitlistOffer[]

  @@index([businessId, status, serviceId])
  @@index([businessId, clientId])
}

model WaitlistOffer {
  id                     String      @id @default(cuid(2))
  businessId             String
  entryId                String
  staffId                String
  startAt                DateTime    @db.Timestamptz(3)
  endAt                  DateTime    @db.Timestamptz(3)
  expiresAt              DateTime    @db.Timestamptz(3)
  status                 OfferStatus @default(OPEN)
  claimedAppointmentId   String?
  freedFromAppointmentId String
  batch                  Int         @default(1)
  emailedAt              DateTime?   @db.Timestamptz(3)
  createdAt              DateTime    @default(now()) @db.Timestamptz(3)

  business           Business      @relation(fields: [businessId], references: [id])
  entry              WaitlistEntry @relation(fields: [entryId], references: [id])
  staff              StaffMember   @relation(fields: [staffId], references: [id])
  claimedAppointment Appointment?  @relation("ClaimedAppointment", fields: [claimedAppointmentId], references: [id])
  freedFrom          Appointment   @relation("FreedFromAppointment", fields: [freedFromAppointmentId], references: [id])

  // One open offer per entry per freed slot.
  @@unique([entryId, freedFromAppointmentId])
  @@index([businessId, status, expiresAt])
  @@index([businessId, entryId])
}

model PilotBaseline {
  id           String   @id @default(cuid(2))
  businessId   String   @unique
  fromDate     DateTime @db.Timestamptz(3)
  toDate       DateTime @db.Timestamptz(3)
  appointments Int
  noShows      Int
  lateCancels  Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])
}

model Payment {
  id            String         @id @default(cuid(2))
  businessId    String
  purpose       PaymentPurpose
  appointmentId String?
  provider      String
  externalId    String
  amount        Decimal        @db.Decimal(10, 2)
  currency      String         @default("USD")
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@unique([provider, externalId])
  @@index([businessId, status])
  @@index([businessId, appointmentId])
}

/// Shared fixed-window rate limiter state. Written only through rateLimit.repo (atomic upsert).
model RateLimitBucket {
  key         String
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// Owner setup assistant (MCP + OAuth 2.1). Hashes only: raw codes and tokens are never stored. See docs/MCP_OWNER.md.
/// A dynamically registered public OAuth client (RFC 7591). The static client `maw3ed-claude` lives in code, not here.
model OAuthClient {
  id           String   @id @default(cuid(2))
  clientId     String   @unique
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

/// One authorization code: 60 s, single use (usedAt), bound to client, redirect, PKCE challenge, user and business.
model OAuthAuthorizationCode {
  id            String    @id @default(cuid(2))
  codeHash      String    @unique
  /// Makes the signed consent form token one-time: the same nonce can never mint a second code.
  consentNonce  String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String?
  scope         String
  userId        String
  businessId    String
  /// Set when the code is exchanged: a later replay of the same code revokes this grant.
  grantId       String?
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([expiresAt])
}

/// One connection of one owner's Claude to one business. Revoking it kills every token.
model OAuthGrant {
  id            String    @id @default(cuid(2))
  businessId    String
  userId        String
  clientId      String
  clientName    String
  scope         String
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens  OAuthAccessToken[]
  refreshTokens OAuthRefreshToken[]
  plans         McpPlan[]
  audit         McpAuditLog[]

  @@index([businessId, revokedAt])
  @@index([userId])
}

model OAuthAccessToken {
  id        String   @id @default(cuid(2))
  grantId   String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([expiresAt])
}

/// Rotation: presenting a token marks it used (usedAt) and issues the next one. A used token shown again = theft:
/// the whole grant is revoked. Hand-written partial unique index: at most one unused refresh token per grant.
model OAuthRefreshToken {
  id        String    @id @default(cuid(2))
  grantId   String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([expiresAt])
}

/// A previewed setup proposal. Business setup data only (names, minutes, prices, hours). Applied at most once.
model McpPlan {
  id           String    @id
  businessId   String
  grantId      String
  proposalJson Json
  proposalHash String
  resultJson   Json?
  expiresAt    DateTime  @db.Timestamptz(3)
  appliedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  grant    OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([businessId, grantId])
  @@index([expiresAt])
}

/// One row per preview/apply: counts and outcome only. No names, no PII, no tokens.
model McpAuditLog {
  id         String   @id @default(cuid(2))
  businessId String
  grantId    String?
  tool       String
  summary    Json
  outcome    String
  at         DateTime @default(now()) @db.Timestamptz(3)

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  grant    OAuthGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@index([businessId, at])
}
