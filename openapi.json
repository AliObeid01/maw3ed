{
  "openapi": "3.1.0",
  "info": {
    "title": "Maw3ed API",
    "version": "0.1.0",
    "description": "Booking and no-show reduction API."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "maw3ed_session"
      },
      "cronSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-cron-secret"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_FAILED"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "data": {}
            },
            "required": [
              "code",
              "message",
              "fields"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status",
          "db"
        ]
      },
      "SignupBody": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "timezone": {
            "type": "string"
          },
          "ownerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "businessName",
          "slug",
          "timezone",
          "ownerName",
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "LoginBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "SlugCheck": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "invalid",
              "reserved",
              "taken"
            ]
          }
        },
        "required": [
          "available"
        ]
      },
      "InviteBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "STAFF"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ],
        "additionalProperties": false
      },
      "AcceptInviteBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "name",
          "password"
        ],
        "additionalProperties": false
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "email"
            ]
          },
          "business": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "slug",
              "name",
              "timezone"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ]
          }
        },
        "required": [
          "user",
          "business",
          "role"
        ]
      },
      "Invite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptUrl": {
            "type": "string",
            "description": "Only returned when EMAIL_PROVIDER=fake (development)."
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "expiresAt"
        ]
      },
      "InvitePreview": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "businessName",
          "email",
          "role",
          "expiresAt"
        ]
      },
      "PublicBusiness": {
        "type": "object",
        "properties": {
          "business": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "locale": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "slug",
              "timezone",
              "locale"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "durationMin": {
                  "type": "integer"
                },
                "bufferMin": {
                  "type": "integer"
                },
                "price": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "name",
                "durationMin",
                "bufferMin",
                "price"
              ]
            }
          },
          "staff": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "serviceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "displayName",
                "serviceIds"
              ]
            }
          }
        },
        "required": [
          "business",
          "services",
          "staff"
        ]
      },
      "Slots": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "endAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "staffId": {
                  "type": "string",
                  "description": "Present only when a specific staff member was requested."
                }
              },
              "required": [
                "startAt",
                "endAt"
              ]
            }
          }
        },
        "required": [
          "slots"
        ]
      },
      "BookingBody": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "format": "cuid2"
          },
          "staffId": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "anyone"
                ]
              },
              {
                "type": "string",
                "format": "cuid2"
              }
            ]
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "client": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "phone": {
                "type": "string",
                "minLength": 3,
                "maxLength": 32
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "phone"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "serviceId",
          "staffId",
          "startAt",
          "client"
        ],
        "additionalProperties": false
      },
      "BookingResult": {
        "type": "object",
        "properties": {
          "appointment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "startAt": {
                "type": "string",
                "format": "date-time"
              },
              "endAt": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string"
              },
              "service": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "durationMin": {
                    "type": "integer"
                  },
                  "price": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "durationMin",
                  "price"
                ]
              },
              "staff": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "displayName"
                ]
              }
            },
            "required": [
              "id",
              "startAt",
              "endAt",
              "status",
              "service",
              "staff"
            ]
          },
          "links": {
            "type": "object",
            "properties": {
              "manage": {
                "type": "string",
                "description": "Signed link, expires at the appointment start."
              }
            },
            "required": [
              "manage"
            ]
          }
        },
        "required": [
          "appointment",
          "links"
        ]
      },
      "Appointment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "service": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "durationMin": {
                "type": "integer"
              },
              "price": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "durationMin",
              "price"
            ]
          },
          "staff": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "displayName"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "FRONT_DESK",
              "WAITLIST"
            ]
          },
          "client": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "noShows": {
                "type": "integer"
              },
              "lateCancels": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "phone",
              "noShows",
              "lateCancels"
            ]
          }
        },
        "required": [
          "id",
          "startAt",
          "endAt",
          "status",
          "service",
          "staff",
          "source",
          "client"
        ]
      },
      "AppointmentList": {
        "type": "object",
        "properties": {
          "appointments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "startAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "endAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "type": "string"
                },
                "service": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "durationMin": {
                      "type": "integer"
                    },
                    "price": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "durationMin",
                    "price"
                  ]
                },
                "staff": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "displayName"
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "PUBLIC",
                    "FRONT_DESK",
                    "WAITLIST"
                  ]
                },
                "client": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "phone": {
                      "type": "string"
                    },
                    "noShows": {
                      "type": "integer"
                    },
                    "lateCancels": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "phone",
                    "noShows",
                    "lateCancels"
                  ]
                }
              },
              "required": [
                "id",
                "startAt",
                "endAt",
                "status",
                "service",
                "staff",
                "source",
                "client"
              ]
            }
          }
        },
        "required": [
          "appointments"
        ]
      },
      "AppointmentDetail": {
        "type": "object",
        "properties": {
          "appointment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "startAt": {
                "type": "string",
                "format": "date-time"
              },
              "endAt": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string"
              },
              "service": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "durationMin": {
                    "type": "integer"
                  },
                  "price": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "durationMin",
                  "price"
                ]
              },
              "staff": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "displayName"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "PUBLIC",
                  "FRONT_DESK",
                  "WAITLIST"
                ]
              },
              "client": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "noShows": {
                    "type": "integer"
                  },
                  "lateCancels": {
                    "type": "integer"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "phone",
                  "noShows",
                  "lateCancels"
                ]
              }
            },
            "required": [
              "id",
              "startAt",
              "endAt",
              "status",
              "service",
              "staff",
              "source",
              "client"
            ]
          }
        },
        "required": [
          "appointment"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness and database ping",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Service and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Create a business and its owner; signs in",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "SLUG_TAKEN or EMAIL_TAKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/slug-check": {
      "get": {
        "summary": "Is a booking-page slug free?",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "required": true,
            "name": "slug",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Availability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlugCheck"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Sign in with email and password",
        "description": "A user with several memberships is signed into the most recently created one. 5 failures per email in 15 minutes -> 429 TOO_MANY_ATTEMPTS.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS (same body for wrong email and wrong password)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "TOO_MANY_ATTEMPTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Sign out: delete the session and clear the cookie",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Current user, business and role",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/invites": {
      "post": {
        "summary": "Invite a staff member by email (OWNER only)",
        "description": "Re-inviting an email replaces its previous open invite. Expires after 72 hours.",
        "tags": [
          "invites"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invite created and emailed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invite"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
